# Modèle du fichier .env — copie-le en « .env » et remplis les valeurs.

DJANGO_SECRET_KEY=remplace-moi-par-une-longue-cle-secrete
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Numéro WhatsApp qui reçoit les commandes (format international sans + ni espaces, ex. 22890000000)
BOUTIQUE_WHATSAPP=

# PostgreSQL (vide = SQLite)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
