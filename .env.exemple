# Modèle du fichier .env : copiez-le en « .env » et remplissez les valeurs.
# Ne partagez jamais le fichier .env et ne l'envoyez pas sur GitHub.

DJANGO_SECRET_KEY=remplacez-moi-par-une-longue-cle-secrete
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# 1 si l'hébergeur passe par un proxy HTTPS (la plupart des hébergeurs)
DJANGO_DERRIERE_PROXY=0
# Adresses IP/CIDR des reverse proxies de confiance (ex. 10.0.0.10,10.0.1.0/24)
DJANGO_TRUSTED_PROXY_IPS=
# 1 seulement si tous les sous-domaines doivent utiliser exclusivement HTTPS
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
# Chemin d'un volume persistant pour les photos (obligatoire en production)
DJANGO_MEDIA_ROOT=
# URL Redis pour les limites anti-abus partagées (obligatoire en production)
DJANGO_CACHE_URL=

# Valeurs par défaut : elles se règlent ensuite dans le back-office (Réglages du site)
# Numéro WhatsApp qui reçoit les commandes, au format international sans + ni espaces (ex. 22890000000)
BOUTIQUE_WHATSAPP=
# Pays livrés, séparés par des virgules (TG = Togo, BJ = Bénin, GH = Ghana)
BOUTIQUE_PAYS=TG

# PostgreSQL (laisser POSTGRES_DB vide uniquement en développement pour utiliser SQLite)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
